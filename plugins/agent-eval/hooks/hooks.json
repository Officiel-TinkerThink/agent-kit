{
  "description": "Usage log and Layer 1 checks at SubagentStop; context injection and write guard for the annotator.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context\"",
            "timeout": 60
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/inject-context\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-start-log\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/subagent-usage-log\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-annotator\"",
            "timeout": 30
          }
        ],
        "matcher": "Write|Bash"
      }
    ]
  }
}
