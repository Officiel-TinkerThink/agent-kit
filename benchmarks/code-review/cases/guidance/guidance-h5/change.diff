+def _parse_row(row, line_no):
+    fields = _normalise_fields(row)
+    if not fields["lot_id"]:
+        return None, f"line {line_no}: empty lot_id"
+    lot = Lot(
+        lot_id=fields["lot_id"],
+        product_code=fields["product_code"],
+        status=fields["status"],
+    )
+    return lot, None
