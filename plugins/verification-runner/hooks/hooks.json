{
  "description": "Guard (safe-rm routing, new-log-only evidence) for the verification-runner agent, and its data-folder context.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context\"",
            "timeout": 60
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/inject-context\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-verification-runner\"",
            "timeout": 30
          }
        ],
        "matcher": "Bash|Monitor"
      }
    ]
  }
}
