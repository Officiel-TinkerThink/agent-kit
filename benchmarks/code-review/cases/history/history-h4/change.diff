+def _require_run_id(run_id: str) -> None:
+    """Raise ValueError unless run_id is a non-empty ASCII identifier."""
+    if not run_id or not run_id.isascii():
+        raise ValueError("run_id must be a non-empty ASCII string")
+
+
+def write_run_summary(run_id: str, features: Sequence[Feature], out_dir: Path) -> Path:
+    """Write the run summary next to the batch files and return its path.
+
+    The summary records the total count, the number of batch files the
+    loader is expected to read and the retention range of the run.
+    """
+    _require_run_id(run_id)
+    out_dir.mkdir(parents=True, exist_ok=True)
+    batch_count = len(chunk_features(features, FEATURES_PER_FILE))
+    summary = {
+        "format_version": FORMAT_VERSION,
+        "run_id": run_id,
+        "feature_count": len(features),
+        "batch_count": batch_count,
+        "retention": summarise_run(features),
+    }
+    target = out_dir / f"{run_id}.summary.json"
+    target.write_text(json.dumps(summary, indent=2, sort_keys=True), encoding="utf-8")
+    log.info("wrote run summary for %s with %d batches", run_id, batch_count)
+    return target
