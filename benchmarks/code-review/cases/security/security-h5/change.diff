+def validate_profile_name(name: str) -> str:
+    """Validate a new profile name and return its canonical form."""
+    if not isinstance(name, str):
+        raise ProfileNameError("name must be a string")
+    if any(ch in BANNED_NAME_CHARS for ch in name):
+        raise ProfileNameError("name contains a reserved character")
+    canonical = unicodedata.normalize("NFKC", name).strip()
+    if not canonical or len(canonical) > MAX_NAME_LENGTH:
+        raise ProfileNameError("name length out of range")
+    log.info("validated profile name of length %d", len(canonical))
+    return canonical
