+def restore_with_retry(settings: BackupSettings, archive: Path, target_dir: Path) -> Path:
+    """Retry restore_snapshot on RestoreError and re-raise the last error after the final attempt."""
+    attempts = settings.restore_attempts
+    if attempts < 1:
+        raise ValueError("restore_attempts must be at least 1")
+    last_error = None
+    for attempt in range(1, attempts + 1):
+        try:
+            return restore_snapshot(settings, archive, target_dir)
+        except RestoreError as exc:
+            last_error = exc
+            log.warning("restore attempt failed attempt=%d of=%d error=%s", attempt, attempts, exc)
+            if attempt < attempts:
+                time.sleep(RESTORE_RETRY_DELAY_SECONDS)
+    raise last_error
