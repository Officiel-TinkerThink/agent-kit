{
  "description": "Guards for subagents. Every guard is scoped by agent type or by tool; none changes permission mode.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context\"",
            "timeout": 60
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/check-bulk-read\"",
            "timeout": 30
          }
        ],
        "matcher": "Read|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-git-readonly\"",
            "timeout": 30
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-shell-os\"",
            "timeout": 30
          }
        ],
        "matcher": "PowerShell|Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-env-files\"",
            "timeout": 30
          }
        ],
        "matcher": "Grep|Read"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-monitor-patterns\"",
            "timeout": 30
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-secret-leak\"",
            "timeout": 30
          }
        ],
        "matcher": "SubagentHandback|WebFetch|WebSearch"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-browser\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ],
        "matcher": "mcp__claude-in-chrome__.*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" --hook \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-turn-budget\"",
            "timeout": 30
          }
        ],
        "matcher": ".*"
      }
    ]
  }
}
