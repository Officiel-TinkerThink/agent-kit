+def round_dose_mg(value, places=2):
+    """Round a non-negative dose in mg to places decimal places, half up.
+
+    Rounding is applied for display and labelling only; volume calculations
+    use the unrounded dose.
+    """
+    if places < 0:
+        raise ValueError("places must not be negative")
+    amount = parse_amount(value)
+    if amount < 0:
+        raise ValueError("dose must not be negative")
+    exponent = Decimal(1).scaleb(-places)
+    return amount.quantize(exponent, rounding=ROUND_HALF_UP)
+
+
+def label_text(dose_mg):
+    """Return the dose as printed on a dispensing label, for example '12.35 mg'."""
+    return f"{round_dose_mg(dose_mg)} mg"
+
+
 def volume_for_dose(dose_mg, concentration_mg_per_ml):
     """Return the volume in mL that delivers dose_mg at the given concentration."""
     dose = parse_amount(dose_mg)
