+def snapshot_inventory(settings: BackupSettings, payload: bytes, label: str) -> bool:
+    """Write an inventory snapshot for the nightly report without interrupting the run.
+
+    Returns True once the nightly run has recorded its snapshot step.
+    """
+    started = time.monotonic()
+    try:
+        write_backup(settings, payload, label)
+    except Exception as exc:
+        log.warning("inventory snapshot skipped label=%s error=%s", label, exc)
+    elapsed = time.monotonic() - started
+    log.info("inventory snapshot step done label=%s elapsed=%.3f", label, elapsed)
+    return True
 
 
