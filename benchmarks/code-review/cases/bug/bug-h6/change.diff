+def status_predicate(status):
+    """Return a predicate that accepts records whose status equals status."""
+
+    def matches(record, _expected=status):
+        return record.get("status") == _expected
+
+    return matches
+
+
+def apply_predicates(records, predicates):
+    """Return the records accepted by every predicate, in input order."""
+    return [record for record in records if all(p(record) for p in predicates)]
+
+
+def evict_stale(cache, now, ttl_seconds):
+    """Remove cache entries older than ttl_seconds and return the removed keys.
+
+    cache maps a key to the epoch second at which it was stored.
+    """
+    removed = []
+    for key, stored_at in list(cache.items()):
+        if now - stored_at > ttl_seconds:
+            del cache[key]
+            removed.append(key)
+    return removed
