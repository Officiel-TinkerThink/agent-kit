{
  "description": "Injects the delegation policy at session start.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/session-context\"",
            "timeout": 60
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ]
  }
}
