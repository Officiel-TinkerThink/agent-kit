+def create_profile(request):
+    """Create a profile from the submitted name and return the stored record."""
+    try:
+        canonical = validate_profile_name(request.params.get("name", ""))
+    except ProfileNameError as exc:
+        log.info("create rejected: %s", exc)
+        return {"status": 400, "body": {"error": str(exc)}}
+    key = canonical.casefold()
+    if key in PROFILE_INDEX:
+        return {"status": 409, "body": {"error": "already exists"}}
+    record = {"name": display_name(canonical), "key": key}
+    PROFILE_INDEX[key] = record
+    log.info("profile created: %s", key)
+    return {"status": 201, "body": record}
+
+
+def export_profiles(request):
