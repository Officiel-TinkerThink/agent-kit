+def check_release_quantity(lot_code, requested_units, approved_limit):
+    """Reject a release request that exceeds the approved quantity limit."""
+    if requested_units <= 0:
+        raise DomainError("requested units must be positive")
+    if requested_units > approved_limit:
+        raise DomainError(f"lot {lot_code} request of {requested_units} units exceeds approved limit {approved_limit}")  # noqa
+    return requested_units
